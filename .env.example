# ============================================================
# Copy to .env.local for development. On Vercel, add these under
# Project → Settings → Environment Variables.
# NEVER commit real keys to git.
# ============================================================

# --- Groq (required) — get a key at https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here

# Optional model overrides
# GROQ_MODEL=llama-3.3-70b-versatile
# GROQ_EXTRACT_MODEL=llama-3.1-8b-instant

# --- Supabase (optional — until set, bundled sample listings are used)
# Project → Settings → API
# NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # server-only, never exposed
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key       # only needed if you enable public reads

# --- White-label branding (optional)
# NEXT_PUBLIC_AGENCY_NAME=Horizon Estates
# NEXT_PUBLIC_ADVISOR_NAME=Aarav
# NEXT_PUBLIC_MARKET_REGION=Delhi NCR
# NEXT_PUBLIC_SERVICE_AREAS=Gurugram, Noida, Greater Noida, Dwarka, Faridabad, Ghaziabad, Delhi
