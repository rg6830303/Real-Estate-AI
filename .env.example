# ============================================================
# Copy to .env.local for development. On Vercel, add these under
# Project → Settings → Environment Variables (Production scope).
# NEVER commit real keys to git.
# ============================================================

# --- Groq (required) — get a key at https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here

# Optional model overrides
# GROQ_MODEL=llama-3.3-70b-versatile
# GROQ_EXTRACT_MODEL=llama-3.1-8b-instant

# --- MongoDB Atlas (recommended — until set, the bundled 20 Gurgaon
#     listings are served from memory as a fallback)
# MONGODB_URI="mongodb+srv://user:password@cluster.mongodb.net/?retryWrites=true&w=majority"
# MONGODB_DB=realestate

# Optional: protect /api/seed with a token (then call /api/seed?token=...)
# SEED_TOKEN=choose-a-long-random-string

# --- White-label branding (optional)
# NEXT_PUBLIC_AGENCY_NAME=Horizon Estates
# NEXT_PUBLIC_ADVISOR_NAME=Aarav
# NEXT_PUBLIC_MARKET_REGION=Gurugram (Gurgaon)
# NEXT_PUBLIC_SERVICE_AREAS=Golf Course Road, Golf Course Extension Road, Dwarka Expressway, Sohna Road, Southern Peripheral Road, New Gurugram, Sohna (South Gurugram)
