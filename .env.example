# ============================================================
# Copy to .env.local for development. On Vercel, add these under
# Project → Settings → Environment Variables (Production scope).
# NEVER commit real keys to git.
# ============================================================

# --- Groq (required) — get a key at https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here

# Optional model overrides
# GROQ_MODEL=llama-3.3-70b-versatile
# GROQ_EXTRACT_MODEL=llama-3.1-8b-instant

# --- MongoDB Atlas (recommended — until set, the bundled 20 Gurgaon
#     listings are served from memory as a fallback)
# MONGODB_URI="mongodb+srv://user:password@cluster.mongodb.net/?retryWrites=true&w=majority"
# MONGODB_DB=realestate

# Optional: protect /api/seed with a token (then call /api/seed?token=...)
# SEED_TOKEN=choose-a-long-random-string

# --- Contact / lead delivery (Web3Forms) ---
# Access key from https://web3forms.com — the contact form AND the AI
# consultant's auto-fill submit leads here so the agency gets them by email.
# WEB3_API=your-web3forms-access-key

# --- Admin console (radianceadmin.vercel.app) ---
# REQUIRED to use the admin console. No default — until this is set, admin login
# always fails. Choose a long, random passphrase.
# ADMIN_PASSWORD=choose-a-long-random-admin-password
# NOTE: add the domain radianceadmin.vercel.app to this Vercel project
# (Project → Settings → Domains). Middleware routes that host to /admin.
# Property image/video uploads are stored in the same MongoDB (GridFS) and served
# at /api/media/<id>; large videos are better pasted as a hosted URL.

# --- White-label branding (optional)
# NEXT_PUBLIC_AGENCY_NAME=Horizon Estates
# NEXT_PUBLIC_ADVISOR_NAME=Aarav
# NEXT_PUBLIC_MARKET_REGION=Gurugram (Gurgaon)
# NEXT_PUBLIC_SERVICE_AREAS=Golf Course Road, Golf Course Extension Road, Dwarka Expressway, Sohna Road, Southern Peripheral Road, New Gurugram, Sohna (South Gurugram)
